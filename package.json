{
  "name": "@local/agentcomm",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "AgentComm: group chats between the user and agents, locally or through a shared relay.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VenusTZZ/dsh-AgentComm.git"
  },
  "homepage": "https://github.com/VenusTZZ/dsh-AgentComm#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "relay/server.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
